#!/usr/bin/env bash

set -eu

usage() {
    printf 'Usage: yt-summary <YouTube-URL>\n' >&2
}

if [[ "$#" -ne 1 ]]; then
    usage
    exit 2
fi

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
esac

emacs_command=${EMACS:-emacs}
if ! command -v "$emacs_command" >/dev/null 2>&1; then
    printf 'yt-summary: Emacs executable not found: %s\n' \
        "$emacs_command" >&2
    exit 127
fi

bin_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
script_dir=$(CDPATH='' cd -- "$bin_dir/.." && pwd)
transcript_file=$(mktemp)
trap 'rm -f -- "$transcript_file"' EXIT
"$bin_dir/yt-transcript" "$1" >"$transcript_file"
BOOST_GPTEL_DIR=$script_dir
BOOST_GPTEL_YOUTUBE_URL=$1
BOOST_GPTEL_YOUTUBE_TRANSCRIPT_FILE=$transcript_file
export BOOST_GPTEL_DIR BOOST_GPTEL_YOUTUBE_URL BOOST_GPTEL_YOUTUBE_TRANSCRIPT_FILE

"$emacs_command" --batch -Q --eval "
(progn
  (setq load-prefer-newer t)
  (require 'package)
  (package-initialize)
  (add-to-list
   'load-path
   (expand-file-name \"lisp\" (getenv \"BOOST_GPTEL_DIR\")))
  (require 'emacs-boost-gptel)
  (with-temp-buffer
    (insert-file-contents (getenv \"BOOST_GPTEL_YOUTUBE_TRANSCRIPT_FILE\"))
    (boost-gptel-summarize-youtube-with-transcript-to-stdout
     (getenv \"BOOST_GPTEL_YOUTUBE_URL\")
     (buffer-string))))"
