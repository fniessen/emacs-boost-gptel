EMACS ?= emacs
BATCH = $(EMACS) -Q --batch
LOAD_PATH = -L lisp -L tests
# Override these paths when packages are installed outside the default ELPA tree.
GPTEL_DIR ?= $(shell find "$(HOME)/.emacs.d" -type f -name gptel.el -print -quit 2>/dev/null | sed 's|/gptel\.el$$||')
GPTEL_AGENT_DIR ?= $(shell find "$(HOME)/.emacs.d" -type f -name gptel-agent.el -print -quit 2>/dev/null | sed 's|/gptel-agent\.el$$||')
LOAD_PATHS ?=
EMACS_LOAD_PATH_ARGS = $(if $(GPTEL_DIR),-L $(GPTEL_DIR)) $(if $(GPTEL_AGENT_DIR),-L $(GPTEL_AGENT_DIR)) $(foreach path,$(LOAD_PATHS),-L $(path))
PACKAGE_INIT_ARGS = --eval "(progn (require 'package) (package-initialize))"
SOURCE = lisp/emacs-boost-gptel.el
TEST_FILES = tests/gptel-tools-test.el tests/agent-todo-test.el \
	tests/youtube-integration-test.el
TEST_LOAD_ARGS = $(foreach file,$(TEST_FILES),-l $(file))

.PHONY: all check tangle test compile clean

# Show this help.
help:
	@printf '%s\n' "Usage: make TARGET" "" "Targets:"
	@awk '\
	/^[[:space:]]*#[[:space:]]/ { \
		description = $$0; \
		sub(/^[[:space:]]*#[[:space:]]*/, "", description); \
		next; \
	} \
	/^[a-zA-Z0-9_-]+:/ { \
		target = $$0; \
		sub(/:.*/, "", target); \
		printf "  %-15s %s\n", target, description; \
		description = ""; \
		next; \
	} \
	{ description = "" }' [Mm]akefile

# Run the complete validation workflow.
all: check

# Tangle, test, and byte-compile the project.
check: tangle test compile

# Generate the Emacs Lisp file from README.org.
tangle:
	$(BATCH) --eval "(progn (require 'org) (require 'ob-tangle) (org-babel-tangle-file \"README.org\"))"

# Run unit tests and the live OpenAI/YouTube integration test.
test: tangle
	$(BATCH) $(PACKAGE_INIT_ARGS) --eval "(setq load-prefer-newer t)" $(LOAD_PATH) $(EMACS_LOAD_PATH_ARGS) $(TEST_LOAD_ARGS) -f ert-run-tests-batch-and-exit

# Byte-compile the generated Emacs Lisp file.
compile: tangle
	$(BATCH) $(PACKAGE_INIT_ARGS) $(LOAD_PATH) $(EMACS_LOAD_PATH_ARGS) --eval "(progn (require 'emacs-boost-gptel) (byte-compile-file \"$(SOURCE)\"))"

# Remove generated byte-compiled files.
clean:
	rm -f lisp/*.elc tests/*.elc
